# Database Connection URL (SQLite for local development, or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# JSON Web Token Secret for Admin Authentication (change to a random 64-char string in production)
JWT_SECRET="your_production_secure_jwt_secret_change_me"

# Environment
NODE_ENV="development"

# Payment Gateway (Optional - configured via Admin Store Settings or .env)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
